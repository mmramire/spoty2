{
  "branchPrefixes": [
    "feat",
    "fix",
    "chore",
    "docs",
    "refactor",
    "test",
    "perf",
    "ci",
    "build",
    "revert"
  ],
  "ticketPattern": "REQ-[0-9]+",
  "maxSummaryLength": 72,
  "duplicateThreshold": 80,
  "runLintBeforeCommit": true,
  "runTestsBeforeCommit": true,
  "interactiveStaging": true,
  "baseBranch": "main",
  "colors": true
}
